{
  "name": "chorus-omnis",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/news/*"]
  },
  "send_email": [{ "name": "EMAIL" }],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "chorus-omnis-media" }
  ]
}
